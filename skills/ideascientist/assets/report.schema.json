{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdeaScientist local proposal",
  "$comment": "Field structure adapted from upstream schema.py at 82a98a08772eab08d11fd097445afa4a8eaaa5b3, CC BY-NC 4.0. Local citations use P001 and sources.json; not upstream evaluator-compatible.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic_relevance": {
      "type": "object",
      "properties": {
        "sub_topic": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_focus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "sub_topic",
        "primary_focus"
      ],
      "additionalProperties": false
    },
    "one_sentence_thesis": {
      "type": "string",
      "minLength": 1
    },
    "core_problem": {
      "type": "object",
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "concrete_example": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "problem_statement",
        "why_it_matters",
        "concrete_example"
      ],
      "additionalProperties": false
    },
    "key_novelty": {
      "type": "object",
      "properties": {
        "main_idea": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "main_idea",
        "explanation"
      ],
      "additionalProperties": false
    },
    "problem_definition": {
      "type": "object",
      "properties": {
        "formal_setting": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "formal_setting",
        "inputs",
        "outputs"
      ],
      "additionalProperties": false
    },
    "key_terms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sub_area": {
            "type": "string",
            "minLength": 1
          },
          "what_it_does": {
            "type": "string",
            "minLength": 1
          },
          "open_gap": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^P[0-9]{3,}$"
            }
          }
        },
        "required": [
          "sub_area",
          "what_it_does",
          "open_gap",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "method": {
      "type": "object",
      "properties": {
        "high_level_flow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "module",
              "role",
              "model",
              "inputs",
              "outputs",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "novel_architectural_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pseudocode": {
          "type": "string",
          "minLength": 1
        },
        "design_choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "theoretical_grounding": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "high_level_flow",
        "modules",
        "novel_architectural_elements",
        "pseudocode",
        "design_choices",
        "theoretical_grounding"
      ],
      "additionalProperties": false
    },
    "model_details": {
      "type": "object",
      "properties": {
        "base_model": {
          "type": "string",
          "minLength": 1
        },
        "training": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "objective_functions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "adaptation": {
              "type": "string",
              "minLength": 1
            },
            "key_hyperparameters": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "method",
            "objective_functions",
            "adaptation",
            "key_hyperparameters"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "base_model",
        "training"
      ],
      "additionalProperties": false
    },
    "comparison_to_sota": {
      "type": "object",
      "properties": {
        "related_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "key_differences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "related_methods",
        "key_differences"
      ],
      "additionalProperties": false
    },
    "proposed_evaluation": {
      "type": "object",
      "properties": {
        "evaluation_setting": {
          "type": "string",
          "minLength": 1
        },
        "benchmarks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "task_type": {
                "type": "string",
                "minLength": 1
              },
              "newly_constructed": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "task_type",
              "newly_constructed"
            ],
            "additionalProperties": false
          }
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "main_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ablations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "evaluation_setting",
        "benchmarks",
        "baselines",
        "main_metrics",
        "ablations"
      ],
      "additionalProperties": false
    },
    "falsifiable_predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "pillar": {
            "type": "string",
            "minLength": 1
          },
          "prediction": {
            "type": "string",
            "minLength": 1
          },
          "kill_condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pillar",
          "prediction",
          "kill_condition"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "title",
    "topic_relevance",
    "one_sentence_thesis",
    "core_problem",
    "key_novelty",
    "problem_definition",
    "key_terms",
    "related_work",
    "method",
    "model_details",
    "comparison_to_sota",
    "proposed_evaluation",
    "falsifiable_predictions",
    "limitations"
  ],
  "additionalProperties": false
}
